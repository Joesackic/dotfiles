
[
  {
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,

    "modules-left": [
      "hyprland/workspaces",
      "cpu",
      "memory",
      "hyprland/window"
    ],

    "modules-center": [
      "clock#time",
      "clock#date"
    ],

    "modules-right": [
      "mpris",
      "tray",
      "pulseaudio#speaker",
      "bluetooth",
      "network",
      "battery"
    ],

    /* Workspaces */

    "hyprland/workspaces": {
      "on-scroll-up": "hyprctl dispatch workspace -1",
      "on-scroll-down": "hyprctl dispatch workspace +1",
      "persistent-workspaces": {
        "1": [],
        "2": [],
        "3": [],
        "4": [],
        "5": []
      }
    },

    /* Active Window */

    "hyprland/window": {
      "format": "{}",
      "icon": true,
      "tooltip": false,
      "max-length": 45,

      
      "rewrite": {
        // Desktop
        "": "<span foreground='#89b4fa'> </span> Hyprland",

        // Terminal
        "~": "  Terminal",
        "zsh": "  Terminal",
        "kitty": "  Terminal",
        "tmux(.*)": "<span foreground='#a6e3a1'> </span> Tmux",

        // Development
        "(.*) - Visual Studio Code":
          "<span foreground='#89b4fa'>󰨞 </span> $1",
        "(.*)Visual Studio Code":
          "<span foreground='#89b4fa'>󰨞 </span> Visual Studio Code",

        "nvim": "<span foreground='#a6e3a1'> </span> Neovim",
        "nvim (.*)": "<span foreground='#a6e3a1'> </span> $1",

        // Media
        "(.*)Spotify":
          "<span foreground='#a6e3a1'> </span> Spotify",
        "(.*)Spotify Premium":
          "<span foreground='#a6e3a1'> </span> Spotify Premium",

        "OBS(.*)":
          "<span foreground='#a6adc8'> </span> OBS Studio",

        "VLC media player":
          "<span foreground='#fab387'>󰕼 </span> VLC Media Player",
        "(.*) - VLC media player":
          "<span foreground='#fab387'>󰕼 </span> $1",

        "(.*) - mpv":
          "<span foreground='#cba6f7'> </span> $1",

        "qView": "  qView",
        "(.*)\\.jpg": "  $1.jpg",
        "(.*)\\.png": "  $1.png",
        "(.*)\\.svg": "  $1.svg",

        // Social
        "vesktop":
          "<span foreground='#89b4fa'> </span> Discord",
        "• Discord(.*)": "Discord$1",
        "(.*)Discord(.*)":
          "<span foreground='#89b4fa'> </span> $1Discord$2",

        // System
        "Authenticate": "  Authenticate"
      }
      
    },

    /* System Information */

    "cpu": {
      "format": "󰻠 {usage}%",
      "tooltip": false,
      "interval": 5
    },

    "memory": {
      "format": "󰘚 {percentage}%",
      "format-critical": "󰀦 {percentage}%",
      "tooltip": false,
      "interval": 5,

      "states": {
        "warning": 75,
        "critical": 90
      }
    },

    /* Time and Date */

    "clock#time": {
      "format": "  {:%H:%M}",
      "tooltip": false
    },

    "clock#date": {
      "format": "󰨳 {:%d-%m-%y}",
      "tooltip-format": "<tt>{calendar}</tt>",

      "calendar": {
        "mode": "month",
        "mode-mon-col": 6,

        "format": {
          "months": "<span color='#b4befe'><b>{}</b></span>",
          "weekdays": "<span color='#a6adc8' font='7'>{}</span>",
          "today": "<span color='#f38ba8'><b>{}</b></span>"
        }
      },

      "actions": {
        "on-click": "mode",
        "on-click-right": "mode"
      }
    },

    /* Media */

    "mpris": {
      "format": "{player_icon} {title} - {artist}",
      "format-paused": "{status_icon} {title} - {artist}",
      "max-length": 40,

      "player-icons": {
        "default": "󰝚",
        "spotify": "<span foreground='#a6e3a1'>󰓇</span>",
        "firefox": "<span foreground='#f38ba8'>󰗃</span>"
      },

      "status-icons": {
        "paused": "<span color='#b4befe'>󰏤</span>"
      },

      "tooltip-format": "Playing: {title} - {artist}",
      "tooltip-format-paused": "Paused: {title} - {artist}"
    },

    /* System Tray */

    "tray": {
      "spacing": 10,
      "icon-size": 14
    },

    /* Audio */

    "pulseaudio#speaker": {
      "format": "{icon} {volume}%",
      "format-muted": "󰝟",
      "format-icons": ["󰕿", "󰖀", "󰕾"],
      "tooltip-format": "{desc} {volume}%",
      "scroll-step": 1,

      "on-click": "pavucontrol",
      "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    /* Connectivity */

    "bluetooth": {
      "format-on": "󰂯",
      "format-off": "󰂲",
      "format-disabled": "󰂲",
      "format-connected": "󰂱 {device_alias}",

      "tooltip-format": "Bluetooth on",
      "tooltip-format-connected": "{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}",

      "on-click": "blueman-manager"
    },

    "network": {
      "interval": 3,

      "format-wifi": "{icon}  {essid} ({signalStrength}%)",
      "format-ethernet": "󰈀",
      "format-linked": "󱘖",
      "format-disconnected": "󰖪",
      "format-disabled": "󰖪",

      "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],

      "tooltip-format-wifi": "{essid} ({signalStrength}%)",
      "tooltip-format-ethernet": "{ifname} {ipaddr}",
      "tooltip-format-disconnected": "Disconnected",

      "on-click": "kitty --title 'Network Manager' nmtui"
    },

    /* Battery */

    "battery": {
      "interval": 10,
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "format-plugged": "󰂄 {capacity}%",
      "tooltip-format": "{timeTo}",

      "states": {
        "good": 90,
        "warning": 30,
        "critical": 15
      },

      "format-icons": [
        "󰁺", "󰁻", "󰁼", "󰁽", "󰁾",
        "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
      ]
    }
  }
]

